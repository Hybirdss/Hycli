{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "resolveJsonModule": true, "esModuleInterop": true,
    "isolatedModules": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "tests"]
}
